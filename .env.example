# Copy to .env and fill in. .env is ignored by git.
MES_DB_HOST=localhost
MES_DB_PORT=5432
MES_DB_NAME=mes_portfolio
MES_DB_USER=postgres
MES_DB_PASSWORD=

# Windows only: uncomment if the psycopg-binary DLL is blocked (for example by Smart App Control).
# db.py then uses libpq.dll from the local PostgreSQL install.
# PSYCOPG_IMPL=python
