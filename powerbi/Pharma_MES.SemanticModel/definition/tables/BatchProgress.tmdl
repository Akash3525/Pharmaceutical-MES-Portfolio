table BatchProgress
	lineageTag: 6ecf7932-4165-49f3-9147-c91b51fb3d5f

	measure Batches = DISTINCTCOUNT ( BatchProgress[batch_no] )
		formatString: 0
		lineageTag: e0f56229-75ed-4a86-a66a-53133c8d9a22

	measure Released = CALCULATE ( [Batches], BatchProgress[status] = "RELEASED" )
		formatString: 0
		lineageTag: 002322ba-000c-421b-bf08-76c08f7d890b

	measure 'Awaiting QA' = CALCULATE ( [Batches], BatchProgress[status] = "COMPLETED" )
		formatString: 0
		lineageTag: 444cb74a-e6b4-4ad8-b801-75955c2696ba

	measure 'Open Deviations' = SUM ( BatchProgress[open_deviations] )
		formatString: 0
		lineageTag: 2ec9abe5-363b-4106-a0a6-fc93794cb8f3

	measure 'Right First Time %' = DIVIDE ( CALCULATE ( [Batches], BatchProgress[total_deviations] = 0, BatchProgress[status] IN { "COMPLETED", "RELEASED" } ), CALCULATE ( [Batches], BatchProgress[status] IN { "COMPLETED", "RELEASED" } ) )
		formatString: 0.0%
		lineageTag: 113ea2ab-6f8e-48c5-a734-cf67839e5e74

	measure 'Avg Release Time (h)' = AVERAGEX ( FILTER ( BatchProgress, BatchProgress[status] = "RELEASED" ), DATEDIFF ( BatchProgress[completed_at], BatchProgress[disposition_at], HOUR ) )
		formatString: 0.0
		lineageTag: 15cf0a91-e92b-45e9-8b1d-f1aac7d7e793

